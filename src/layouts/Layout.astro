---
import "../styles/global.css";
import SEO from "../components/SEO.astro";

interface OgImage {
  url: string;
  alt?: string;
}

interface ArticleSeoMeta {
  publishedTime: string;
  modifiedTime?: string;
  section: string;
  tags: string[];
}

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: "article";
  ogImage?: OgImage;
  article?: ArticleSeoMeta;
  jsonLd?: Record<string, unknown>;
}

const {
  title = "8LEAKS — Información, contexto y análisis",
  description = "Política, economía, geopolítica y psicología con análisis riguroso.",
  canonical,
  ogType,
  ogImage,
  article,
  jsonLd,
} = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      ogType={ogType}
      ogImage={ogImage}
      article={article}
      jsonLd={jsonLd}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Outfit:wght@100..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
