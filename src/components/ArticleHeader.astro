---
// Cabecera editorial del artículo individual — clasificación, título y
// metadata (autor + fecha), dentro de la columna de artículo del grid (ver
// [slug].astro). Sin cards, sin fondos, sin líneas decorativas, sin ámbar.
// Sin bajada/dek ni tiempo de lectura debajo del H1 — a pedido explícito.
import type { CollectionEntry } from "astro:content";
import { articleEyebrow, formatArticleDateLong } from "../lib/content-format";

interface Props {
  article: CollectionEntry<"articulos">;
  authors: CollectionEntry<"autores">[];
}

const { article, authors } = Astro.props;
const { title, category, subcategory, editorialType, publishedAt, updatedAt } = article.data;
const wasUpdated = updatedAt && updatedAt.getTime() !== publishedAt.getTime();
const primaryAuthor = authors[0] ?? null;
---

<header class="article-header">
  <p class="article-header__eyebrow">{articleEyebrow({ category, subcategory, editorialType })}</p>
  <h1 class="article-header__title">{title}</h1>
  <div class="article-header__meta">
    {primaryAuthor && (
      <p class="article-header__byline">
        <span class="article-header__by">Por</span>{" "}
        {/* Sin ruta de autor todavía (src/pages/autores/ no existe — ver
            Footer.astro, "Autores" sigue como plannedPath sin href). Queda
            en texto negro+subrayado, listo para volverse <a> real apenas
            exista esa página, sin inventar un href ahora. */}
        <span class="article-header__author-name">{primaryAuthor.data.name}</span>
      </p>
    )}
    <p class="article-header__date">
      <time datetime={publishedAt.toISOString()}>{formatArticleDateLong(publishedAt)}</time>
    </p>
    {wasUpdated && updatedAt && (
      <p class="article-header__updated">
        Actualizado el <time datetime={updatedAt.toISOString()}>{formatArticleDateLong(updatedAt)}</time>
      </p>
    )}
  </div>
</header>

<style>
  .article-header {
    padding-block: var(--space-6) var(--space-7);
  }

  .article-header__eyebrow {
    color: var(--color-graphite-600);
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: var(--tracking-body);
    line-height: var(--leading-meta);
    margin-bottom: var(--space-4);
  }

  .article-header__title {
    color: var(--color-black);
    font-size: var(--text-article-title);
    font-weight: 700;
    line-height: var(--leading-solid);
    letter-spacing: var(--tracking-display);
  }

  .article-header__meta {
    margin-top: var(--space-4);
  }

  .article-header__byline,
  .article-header__date,
  .article-header__updated {
    /* Más chico que --text-meta (14px) y que el cuerpo del artículo
       (--text-article-body, 16px) — a pedido explícito. */
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: var(--leading-meta);
  }

  .article-header__date,
  .article-header__updated {
    margin-top: var(--space-1);
  }

  .article-header__date {
    color: var(--color-graphite-600);
  }

  .article-header__updated {
    /* 2px más que los 0.8125rem (13px) compartidos con byline/fecha. */
    font-size: 0.9375rem;
    color: var(--color-black);
    font-weight: 500;
    font-style: italic;
  }

  .article-header__by {
    color: var(--color-graphite-600);
  }

  .article-header__author-name {
    color: var(--color-black);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
