---
// Los items de navegación son rutas planificadas (fase de categorías, aún
// no construida). Se muestran como texto con la tipografía/espaciado de un
// enlace, pero deliberadamente no son <a>: evita 404 y href="#" mientras la
// ruta no existe. Cuando se construyan las páginas de categoría, se activan
// como enlaces reales sin cambios visuales.
const NAV_ITEMS = [
  { label: "Política", plannedPath: "/politica/" },
  { label: "Economía", plannedPath: "/economia/" },
  { label: "Geopolítica", plannedPath: "/geopolitica/" },
  { label: "Psicología", plannedPath: "/psicologia/" },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <div class="site-header__brand">
      <img
        src="/brand/8leaks-logo-horizontal.png"
        alt="8LEAKS"
        class="site-header__logo"
        width="326"
        height="109"
      />
    </div>

    <button
      type="button"
      class="nav-toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <span class="visually-hidden">Abrir menú</span>
      <span class="nav-toggle__bars" aria-hidden="true"></span>
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label="Secciones principales">
      <ul class="primary-nav__list">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <span class="primary-nav__link" data-planned-path={item.plannedPath}>
                {item.label}
              </span>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-black);
    border-bottom: var(--border-hairline-dark);
    transform: translateY(0);
  }

  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header {
      transition: transform 320ms ease;
    }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: 7px;
  }

  .site-header__logo {
    display: block;
    height: 48px;
    width: auto;
  }

  .nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid var(--color-border-on-dark);
    border-radius: var(--radius-subtle);
    cursor: pointer;
  }

  .nav-toggle__bars,
  .nav-toggle__bars::before,
  .nav-toggle__bars::after {
    content: "";
    display: block;
    width: 18px;
    height: 1px;
    background: var(--color-text-on-dark);
  }

  .nav-toggle__bars {
    position: relative;
  }

  .nav-toggle__bars::before {
    position: absolute;
    top: -6px;
  }

  .nav-toggle__bars::after {
    position: absolute;
    top: 6px;
  }

  .primary-nav {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    background: var(--color-black);
    border-top: var(--border-hairline-dark);
    max-height: 0;
    overflow: hidden;
  }

  .primary-nav.is-open {
    max-height: 320px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .primary-nav {
      transition: max-height 0.25s ease;
    }
  }

  .primary-nav__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) var(--container-padding);
  }

  .primary-nav__link {
    display: block;
    padding-block: var(--space-3);
    font-size: var(--text-nav);
    font-weight: 400;
    line-height: var(--leading-meta);
    letter-spacing: var(--tracking-body);
    color: var(--color-text-on-dark);
    cursor: default;
  }

  .primary-nav__link:hover {
    opacity: 0.6;
  }

  @media (min-width: 768px) {
    .site-header__inner {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }

    .site-header__brand {
      grid-column: 1;
      justify-self: start;
    }

    .nav-toggle {
      display: none;
    }

    .primary-nav {
      grid-column: 2;
      justify-self: center;
      position: static;
      max-height: none;
      overflow: visible;
      border-top: none;
      background: transparent;
    }

    .primary-nav__list {
      flex-direction: row;
      gap: var(--space-6);
      padding: 0;
    }

    .primary-nav__link {
      padding-block: var(--space-2);
    }
  }
</style>

<script>
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("primary-nav");

  if (toggle && nav) {
    const closeNav = () => {
      nav.classList.remove("is-open");
      toggle.setAttribute("aria-expanded", "false");
    };

    const openNav = () => {
      nav.classList.add("is-open");
      toggle.setAttribute("aria-expanded", "true");
    };

    toggle.addEventListener("click", () => {
      if (nav.classList.contains("is-open")) {
        closeNav();
      } else {
        openNav();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("is-open")) {
        closeNav();
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      if (!nav.classList.contains("is-open")) return;
      const target = event.target;
      if (target instanceof Node && !nav.contains(target) && !toggle.contains(target)) {
        closeNav();
      }
    });

    const desktopQuery = window.matchMedia("(min-width: 768px)");
    desktopQuery.addEventListener("change", (event) => {
      if (event.matches) closeNav();
    });
  }

  // Header "smart": se oculta al bajar, reaparece al subir o al detenerse
  // el scroll. No se oculta con el menú mobile abierto ni cerca del tope.
  const header = document.querySelector(".site-header");
  if (header) {
    const HIDE_THRESHOLD = 80;
    let lastScrollY = window.scrollY;
    let idleTimer: ReturnType<typeof setTimeout> | undefined;

    const show = () => header.classList.remove("is-hidden");
    const hide = () => header.classList.add("is-hidden");

    window.addEventListener(
      "scroll",
      () => {
        const currentY = window.scrollY;

        if (nav && nav.classList.contains("is-open")) {
          lastScrollY = currentY;
          return;
        }

        if (currentY <= HIDE_THRESHOLD) {
          show();
        } else if (currentY > lastScrollY) {
          hide();
        } else if (currentY < lastScrollY) {
          show();
        }

        lastScrollY = currentY;

        clearTimeout(idleTimer);
        idleTimer = setTimeout(show, 600);
      },
      { passive: true },
    );
  }
</script>
