---
// Envoltorio del cuerpo Markdown renderizado (<Content />). Cuerpo gris
// (nunca negro puro), ancho de lectura controlado, line-height generoso.
// h2/h3/listas/blockquotes/enlaces/imágenes reciben estilos editoriales
// coherentes con el resto del sitio — sin bordes ni decoración excesiva.
---

<div class="article-body">
  <slot />
</div>

<style>
  .article-body {
    color: var(--color-graphite-600);
    font-size: var(--text-article-body);
    /* 1.5 — mide exactamente el ratio font-size/line-height del cuerpo de
       blog.x.com (16px/24px). Ninguno de los leading-* existentes da 1.5
       (--leading-snug:1.35, --leading-normal:1.6), por eso va explícito. */
    line-height: 1.5;
  }

  .article-body :global(p) {
    margin-block: var(--space-5);
  }

  .article-body :global(p:first-child) {
    margin-top: 0;
  }

  .article-body :global(h2) {
    color: var(--color-black); /* solo h2 en negro — a pedido explícito */
    font-size: 1.25rem;
    font-weight: 700;
    line-height: var(--leading-solid);
    letter-spacing: var(--tracking-display);
    margin-block: var(--space-8) var(--space-4);
  }

  .article-body :global(h3) {
    color: #657786; /* valor exacto pedido para h2/h3/h4 del cuerpo */
    font-size: 1.125rem;
    font-weight: 700;
    line-height: var(--leading-solid);
    margin-block: var(--space-7) var(--space-3);
  }

  .article-body :global(h4) {
    color: #657786; /* valor exacto pedido para h2/h3/h4 del cuerpo */
    font-size: 1rem;
    font-weight: 700;
    line-height: var(--leading-solid);
    margin-block: var(--space-6) var(--space-2);
  }

  .article-body :global(strong) {
    color: var(--color-ink-900);
    font-weight: 700;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin-block: var(--space-5);
    padding-left: 1.25em;
  }

  .article-body :global(ul) {
    list-style: disc;
  }

  .article-body :global(ol) {
    list-style: decimal;
  }

  .article-body :global(li) {
    margin-block: var(--space-2);
  }

  .article-body :global(a) {
    color: var(--color-ink-900);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-body :global(a:hover) {
    opacity: 0.7;
  }

  .article-body :global(blockquote) {
    margin-block: var(--space-6);
    padding-left: var(--space-5);
    border-left: 2px solid var(--color-gray-200);
    color: var(--color-graphite-600);
    font-style: italic;
  }

  .article-body :global(blockquote p) {
    margin-block: var(--space-2);
  }

  .article-body :global(img) {
    width: 100%;
    height: auto;
    margin-block: var(--space-6);
    border-radius: var(--radius-subtle);
  }

  .article-body :global(hr) {
    border: none;
    border-top: var(--border-hairline-light);
    margin-block: var(--space-8);
  }
</style>
