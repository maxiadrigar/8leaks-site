---
// Fila tipográfica de post — sin imagen, sin card, sin borde. Todos los
// posts se ven exactamente igual (featured es solo un criterio de orden,
// ver index.astro), como en el listado "Latest posts" de blog.x.com.
//
// El título es el enlace principal hacia la página individual del
// artículo (misma URL que genera src/pages/articulos/[slug].astro:
// /articulos/<article.id>/, igual que ArticleRelated.astro).
import type { CollectionEntry } from "astro:content";
import { categoryLabel, formatArticleDateListing } from "../lib/content-format";

interface Props {
  article: CollectionEntry<"articulos">;
  author: CollectionEntry<"autores"> | null;
}

const { article, author } = Astro.props;
const { title, category, publishedAt } = article.data;
---

<article class="post-row">
  <p class="post-row__eyebrow">{categoryLabel(category)}</p>
  <h3 class="post-row__title"><a href={`/articulos/${article.id}/`}>{title}</a></h3>
  <p class="post-row__meta">
    {author && (
      <>
        <span class="post-row__by">Por</span>{" "}
        <span class="post-row__author-name">{author.data.name}</span>
        <span class="post-row__comma">, </span>
      </>
    )}
    <time datetime={publishedAt.toISOString()}>{formatArticleDateListing(publishedAt)}</time>
  </p>
</article>

<style>
  .post-row {
    padding-block: var(--space-7);
  }

  .post-row__eyebrow {
    color: var(--color-graphite-600);
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: var(--tracking-body);
    line-height: var(--leading-meta);
    margin-bottom: var(--space-3);
  }

  .post-row__title {
    font-size: var(--text-post-title);
    font-weight: 700;
    line-height: var(--leading-solid);
    letter-spacing: var(--tracking-display);
    max-width: 44ch;
  }

  .post-row__title a {
    color: var(--color-graphite-600);
    text-decoration: none;
  }

  .post-row__title a:hover {
    color: var(--color-ink-950);
    transition: color 180ms ease;
  }

  .post-row__meta {
    margin-top: var(--space-4);
    color: var(--color-graphite-600);
    font-size: var(--text-meta);
    line-height: var(--leading-meta);
  }

  .post-row__author-name {
    color: var(--color-black);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
