---
// Único componente responsable de las etiquetas SEO/social del <head>,
// montado por Layout.astro para cualquier página. title/description son
// obligatorios y siempre se renderizan (comportamiento actual, sin
// regresión). El resto de los props son opcionales y aditivos: si no se
// pasan, la etiqueta correspondiente simplemente no se renderiza — Home,
// categorías, subcategorías y 404 no pasan canonical/ogType/ogImage/article
// en esta fase, así que su <head> no cambia en absoluto. Article Pages
// pasa el set completo (ver src/pages/articulos/[slug].astro).
interface OgImage {
  url: string;
  alt?: string;
}

interface ArticleSeoMeta {
  publishedTime: string;
  modifiedTime?: string;
  section: string;
  tags: string[];
}

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: "article";
  ogImage?: OgImage;
  article?: ArticleSeoMeta;
}

const { title, description, canonical, ogType, ogImage, article } = Astro.props;
---

<title>{title}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}
{
  ogType && (
    <>
      <meta property="og:type" content={ogType} />
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />
      {canonical && <meta property="og:url" content={canonical} />}
      <meta property="og:site_name" content="8LEAKS" />
      <meta property="og:locale" content="es_AR" />
      {ogImage && <meta property="og:image" content={ogImage.url} />}
      {ogImage?.alt && <meta property="og:image:alt" content={ogImage.alt} />}
      {ogImage && (
        <>
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={ogImage.url} />
        </>
      )}
    </>
  )
}
{
  article && (
    <>
      <meta property="article:published_time" content={article.publishedTime} />
      {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
      <meta property="article:section" content={article.section} />
      {article.tags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}
