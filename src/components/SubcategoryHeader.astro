---
// Cabecera editorial tipográfica de las Subcategory Pages de "Otros Blogs"
// (Tecnología, y futuras Educación/Cultura/Deporte) — segundo lenguaje
// visual del sistema, deliberadamente distinto de CategoryBanner: sin
// imagen, sin fondo de color, puro tipográfico sobre --color-paper. El
// violeta (identidad de Otros Blogs) aparece únicamente en el eyebrow y en
// la línea fina, nunca en el título ni como fondo. Ver docs/DESIGN-SYSTEM.md
// § Subcategory Pages.
interface Props {
  parentLabel: string;
  title: string;
  subtitle: string;
}

const { parentLabel, title, subtitle } = Astro.props;
---

<section class="subcategory-header">
  <div class="container subcategory-header__inner">
    <p class="subcategory-header__eyebrow">{parentLabel}</p>
    <span class="subcategory-header__rule" aria-hidden="true"></span>
    <h1 class="subcategory-header__title">{title}</h1>
    <p class="subcategory-header__subtitle">{subtitle}</p>
    <div class="subcategory-header__divider" aria-hidden="true"></div>
  </div>
</section>

<style>
  .subcategory-header {
    background: var(--color-paper);
    padding-block: var(--space-7) var(--space-6);
  }

  .subcategory-header__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .subcategory-header__eyebrow {
    color: var(--color-violet-600);
    font-size: var(--text-meta);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    line-height: var(--leading-meta);
  }

  .subcategory-header__rule {
    margin-top: var(--space-3);
    width: 32px;
    height: 2px;
    background: var(--color-violet-500);
  }

  .subcategory-header__title {
    margin-top: var(--space-6);
    color: var(--color-ink-950);
    font-size: clamp(2.5rem, 1.7rem + 4vw, 4.75rem);
    font-weight: 700;
    line-height: var(--leading-solid);
    letter-spacing: var(--tracking-display);
  }

  .subcategory-header__subtitle {
    margin-top: var(--space-5);
    max-width: 46ch;
    color: var(--color-graphite-600);
    font-size: var(--text-hero-support);
    font-weight: 500;
    line-height: var(--leading-snug);
  }

  /* Separa el bloque de cabecera (eyebrow/título/subtítulo) del listado de
     posts que sigue debajo — ancha (ocupa el ancho del container) pero
     delicada: apenas un poco más gruesa que la rulita del eyebrow. */
  .subcategory-header__divider {
    margin-top: var(--space-6);
    width: 100%;
    height: 3px;
    background: var(--color-violet-500);
  }

  @media (max-width: 640px) {
    .subcategory-header {
      padding-block: var(--space-6) var(--space-5);
    }

    .subcategory-header__subtitle {
      max-width: 32ch;
    }

    .subcategory-header__divider {
      margin-top: var(--space-5);
    }
  }
</style>
