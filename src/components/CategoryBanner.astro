---
// Banner institucional de sección (Política, Economía, Geopolítica, Otros
// Blogs) — mismo patrón de imagen-de-fondo-a-pantalla-completa que ya usa
// Hero.astro: <img> absoluta + object-fit: cover, no background-image.
// Overlay deliberadamente muy suave: solo para legibilidad del texto, no
// para oscurecer el banner.
interface Props {
  title: string;
  subtitle: string;
  imageSrc: string;
  overlayHeader?: boolean;
}

const { title, subtitle, imageSrc, overlayHeader = false } = Astro.props;
---

<section
  class:list={["category-banner", { "category-banner--overlay": overlayHeader }]}
  data-header-overlay-target={overlayHeader || undefined}
>
  <img src={imageSrc} alt="" aria-hidden="true" class="category-banner__image" />
  <div class="category-banner__overlay" aria-hidden="true"></div>

  <div class="container category-banner__content">
    <h1 class="category-banner__title">{title}</h1>
    <p class="category-banner__subtitle">{subtitle}</p>
  </div>
</section>

<style>
  .category-banner {
    position: relative;
    overflow: hidden;
    min-height: clamp(320px, 42vh, 480px);
    display: flex;
    align-items: center;
  }

  /* Header height (51px, medida en runtime vía getBoundingClientRect: el
     alto real lo fija el nav/toggle de 40px, no el logo de 18px — ver
     Header.astro). Extiende el banner detrás del Header transparente sin
     mover el borde inferior ni el texto de su posición visual habitual. */
  .category-banner--overlay {
    margin-top: -51px;
    padding-top: 51px;
  }

  .category-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .category-banner__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.12);
  }

  .category-banner__content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-block: var(--space-8);
  }

  .category-banner__title {
    max-width: 900px;
    color: var(--color-text-on-dark);
    font-size: clamp(2rem, 1.2rem + 3.8vw, 4rem);
    font-weight: 700;
    line-height: var(--leading-solid);
    letter-spacing: var(--tracking-display);
  }

  .category-banner__subtitle {
    margin-top: var(--space-4);
    color: var(--color-text-on-dark);
    font-size: var(--text-hero-support);
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .category-banner {
      min-height: clamp(240px, 46vh, 360px);
    }

    .category-banner__content {
      padding-block: var(--space-7);
    }
  }
</style>
