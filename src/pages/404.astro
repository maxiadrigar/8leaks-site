---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="404 — Página no encontrada — 8LEAKS" description="La página que buscás no existe o fue movida.">
  <Header />
  <main class="not-found container">
    <p class="not-found__code">404</p>
    <h1 class="not-found__title">Página no encontrada</h1>
    <p class="not-found__text">La página que buscás no existe o fue movida.</p>
    <a href="/" class="not-found__link">Volver al inicio</a>
  </main>
  <Footer />
</Layout>

<style>
  .not-found {
    padding-block: var(--space-10) var(--space-10);
    text-align: center;
  }

  .not-found__code {
    color: var(--color-graphite-600);
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: var(--tracking-body);
    margin-bottom: var(--space-4);
  }

  .not-found__title {
    color: var(--color-black);
    font-size: var(--text-section-heading);
    letter-spacing: var(--tracking-display);
  }

  .not-found__text {
    margin-top: var(--space-4);
    color: var(--color-graphite-600);
    font-size: var(--text-body);
  }

  .not-found__link {
    display: inline-block;
    margin-top: var(--space-6);
    color: var(--color-black);
    font-size: var(--text-meta);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .not-found__link:hover {
    opacity: 0.7;
  }
</style>
