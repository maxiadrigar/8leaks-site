---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CategoryBanner from "../../components/CategoryBanner.astro";
import LatestArticles from "../../components/LatestArticles.astro";
import { getPublishedArticlesByCategory } from "../../lib/articles";

const items = await getPublishedArticlesByCategory("economia");
---

<Layout
  title="Economía — 8LEAKS"
  description="Economía argentina, actualidad, análisis e investigación en 8LEAKS."
>
  <Header transparentOverHero />
  <main>
    <CategoryBanner
      title="Economía en foco"
      subtitle="Argentina"
      imageSrc="/banners/banner-economia.png"
      overlayHeader
    />
    <LatestArticles items={items} />
  </main>
  <Footer />
</Layout>
