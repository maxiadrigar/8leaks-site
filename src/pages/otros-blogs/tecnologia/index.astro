---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import SubcategoryHeader from "../../../components/SubcategoryHeader.astro";
import LatestArticles from "../../../components/LatestArticles.astro";
import { getPublishedArticlesByCategory } from "../../../lib/articles";

const items = await getPublishedArticlesByCategory("otros-blogs", "tecnologia");
---

<Layout
  title="Tecnología — 8LEAKS"
  description="Tecnología, innovación y poder en la era digital en 8LEAKS."
>
  <Header />
  <main>
    <SubcategoryHeader
      parentLabel="Otros Blogs"
      title="Tecnología"
      subtitle="Innovación y poder en la era digital."
    />
    <LatestArticles items={items} dividerColor="var(--color-violet-500)" />
  </main>
  <Footer />
</Layout>
