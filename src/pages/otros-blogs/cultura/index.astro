---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import SubcategoryHeader from "../../../components/SubcategoryHeader.astro";
import LatestArticles from "../../../components/LatestArticles.astro";
import { getPublishedArticlesByCategory } from "../../../lib/articles";

const items = await getPublishedArticlesByCategory("otros-blogs", "cultura");
---

<Layout
  title="Cultura — 8LEAKS"
  description="Cultura, ideas y análisis sobre los fenómenos y expresiones de nuestro tiempo en 8LEAKS."
>
  <Header />
  <main>
    <SubcategoryHeader
      parentLabel="Otros Blogs"
      title="Cultura"
      subtitle="Ideas, expresiones y fenómenos de nuestro tiempo."
    />
    <LatestArticles items={items} dividerColor="var(--color-violet-500)" />
  </main>
  <Footer />
</Layout>
