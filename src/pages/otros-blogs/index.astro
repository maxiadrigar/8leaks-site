---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CategoryBanner from "../../components/CategoryBanner.astro";
import LatestArticles from "../../components/LatestArticles.astro";
import { getPublishedArticlesByCategory } from "../../lib/articles";

const items = await getPublishedArticlesByCategory("otros-blogs");
---

<Layout
  title="Otros Blogs — 8LEAKS"
  description="Tecnología, cultura, educación, deporte, ideas y otros temas en 8LEAKS."
>
  <Header transparentOverHero />
  <main>
    <CategoryBanner
      title="Otros artículos"
      subtitle="Blog"
      imageSrc="/banners/banner-otros-blogs.png"
      overlayHeader
    />
    <LatestArticles items={items} />
  </main>
  <Footer />
</Layout>
