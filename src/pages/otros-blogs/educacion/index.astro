---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import SubcategoryHeader from "../../../components/SubcategoryHeader.astro";
import LatestArticles from "../../../components/LatestArticles.astro";
import { getPublishedArticlesByCategory } from "../../../lib/articles";

const items = await getPublishedArticlesByCategory("otros-blogs", "educacion");
---

<Layout
  title="Educación — 8LEAKS"
  description="Educación, aprendizaje y análisis sobre los desafíos de enseñar y aprender en 8LEAKS."
>
  <Header />
  <main>
    <SubcategoryHeader
      parentLabel="Otros Blogs"
      title="Educación"
      subtitle="Aprender, enseñar y pensar la educación."
    />
    <LatestArticles items={items} dividerColor="var(--color-violet-500)" />
  </main>
  <Footer />
</Layout>
