---
import { getCollection, getEntry, type CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import LatestArticles from "../components/LatestArticles.astro";
import Footer from "../components/Footer.astro";

type Articulo = CollectionEntry<"articulos">;

const POSTS_LIMIT = 6;

// featured/featuredOrder son una herramienta puramente editorial de orden
// de aparición — no generan ningún tratamiento visual distinto (todos los
// posts se ven igual, ver PostRow.astro). Primero los destacados según
// featuredOrder, después el resto por fecha de publicación descendente.
function sortForHome(a: Articulo, b: Articulo): number {
  if (a.data.featured !== b.data.featured) {
    return a.data.featured ? -1 : 1;
  }
  if (a.data.featured && b.data.featured) {
    const orderA = a.data.featuredOrder ?? Number.POSITIVE_INFINITY;
    const orderB = b.data.featuredOrder ?? Number.POSITIVE_INFINITY;
    if (orderA !== orderB) return orderA - orderB;
  }
  return b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf();
}

const publishedArticles = (await getCollection("articulos", ({ data }) => !data.draft)).sort(
  sortForHome,
);

async function withAuthor(article: Articulo) {
  const author = await getEntry(article.data.author[0]);
  return { article, author: author ?? null };
}

const items = await Promise.all(publishedArticles.slice(0, POSTS_LIMIT).map(withAuthor));
---

<Layout>
  <Header />
  <main>
    <Hero />
    <LatestArticles items={items} />
  </main>
  <Footer />
</Layout>
