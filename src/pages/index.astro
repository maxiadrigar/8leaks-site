---
// Página de verificación de la Fase 1 — sin diseño visual definitivo.
// Prueba, de punta a punta, que Content Collections + el schema Zod +
// la referencia articulo -> autor funcionan sobre la API actual de Astro.
import { getCollection, getEntry } from "astro:content";

const articulos = (await getCollection("articulos", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const articulosConAutor = await Promise.all(
  articulos.map(async (articulo) => {
    const autor = await getEntry(articulo.data.author[0]);
    return { articulo, autor };
  }),
);
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>8leaks — verificación de Fase 1</title>
	</head>
	<body>
		<h1>8leaks — bootstrap del proyecto</h1>
		<p>Esta página existe únicamente para verificar que Content Collections, el schema Zod y la relación artículo → autor funcionan. Se reemplaza por completo en fases posteriores.</p>
		<ul>
			{articulosConAutor.map(({ articulo, autor }) => (
				<li>
					<strong>{articulo.data.title}</strong>
					— {articulo.data.category} —
					por {autor.data.name}
					({articulo.data.publishedAt.toISOString().slice(0, 10)})
				</li>
			))}
		</ul>
	</body>
</html>
