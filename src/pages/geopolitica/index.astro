---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CategoryBanner from "../../components/CategoryBanner.astro";
import LatestArticles from "../../components/LatestArticles.astro";
import { getPublishedArticlesByCategory } from "../../lib/articles";

const items = await getPublishedArticlesByCategory("geopolitica");
---

<Layout
  title="Geopolítica — 8LEAKS"
  description="Política internacional, geopolítica, actualidad, análisis e investigación en 8LEAKS."
>
  <Header transparentOverHero />
  <main>
    <CategoryBanner
      title="Política Internacional"
      subtitle="Geopolítica"
      imageSrc="/banners/banner-geopolitica.png"
      overlayHeader
    />
    <LatestArticles items={items} />
  </main>
  <Footer />
</Layout>
