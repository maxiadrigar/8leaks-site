---
import { getCollection, getEntry, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ArticleHeader from "../../components/ArticleHeader.astro";
import ArticleBrandIdentity from "../../components/ArticleBrandIdentity.astro";
import ArticleCover from "../../components/ArticleCover.astro";
import ArticleBody from "../../components/ArticleBody.astro";
import ArticleSources from "../../components/ArticleSources.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articulos", ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<"articulos">;
}

const { article } = Astro.props;
const { Content } = await render(article);
const author = await getEntry(article.data.author[0]);

const pageTitle = article.data.seo?.title ?? `${article.data.title} — 8LEAKS`;
const pageDescription = article.data.seo?.description ?? article.data.excerpt;
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />
  <main class="article">
    <ArticleBrandIdentity />
    <ArticleHeader article={article} author={author ?? null} />
    <ArticleCover coverImage={article.data.coverImage} />
    <ArticleBody>
      <Content />
    </ArticleBody>
    <ArticleSources sources={article.data.sources} />
  </main>
  <Footer />
</Layout>

<style>
  .article {
    position: relative;
  }
</style>
